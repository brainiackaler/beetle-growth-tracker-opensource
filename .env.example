# Required. Generate at least 32 random bytes; never reuse this sample value.
JWT_SECRET=

# Docker access. Keep 127.0.0.1 unless a LAN/reverse proxy must reach the app.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8088

# Keep registration enabled only until the required accounts have been created.
REGISTRATION_ENABLED=true

# Optional database override. Defaults to persistent local H2 in /app/data.
# DATABASE_URL=jdbc:mysql://db.example.com:3306/beetle_growth?useSSL=true&serverTimezone=UTC
# DB_USERNAME=beetle_app
# DB_PASSWORD=replace-me

# Optional public Supabase Storage bucket. Photos uploaded there are publicly readable.
# STORAGE_SUPABASE_URL=https://your-project.supabase.co
# STORAGE_SUPABASE_BUCKET=beetle-images
# STORAGE_SUPABASE_KEY=replace-with-server-side-key

# Optional Bark icon. Must be an absolute public HTTPS URL.
# BARK_ICON_URL=https://example.com/beetle-logo.png

# Optional Telegram bot and webhook.
# TELEGRAM_BOT_TOKEN=replace-me
# TELEGRAM_BOT_USERNAME=your_bot
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
# TELEGRAM_WEBHOOK_URL=https://beetles.example.com/api/integrations/telegram/webhook

# Optional Telegram API proxy.
# TELEGRAM_API_PROXY_URL=https://your-project.supabase.co/functions/v1/telegram-proxy
# TELEGRAM_API_PROXY_SECRET=replace-with-a-random-secret
