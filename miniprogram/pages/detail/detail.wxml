<view class="page">
  <!-- 甲虫信息卡 -->
  <view wx:if="{{beetle && !isEditingBeetle}}" class="card beetle-info">
    <view class="title">🪲 {{beetle.name || i18n.unnamedBeetle}}</view>
    <view class="info-meta">
      <view wx:if="{{beetle.species}}" class="info-tag">
        <text class="info-icon">🔬</text>
        <text>{{beetle.species}}</text>
      </view>
      <view wx:if="{{beetle.hatchDate}}" class="info-tag">
        <text class="info-icon">📅</text>
        <text>{{beetle.hatchDate}}</text>
      </view>
    </view>
    <view wx:if="{{beetle.notes}}" class="notes">{{beetle.notes}}</view>
    <view class="button-row detail-actions" style="margin-top: 16px;">
      <button class="primary-btn" bindtap="openEditBeetle" style="min-height:70rpx; font-size:26rpx; line-height: 70rpx;">{{i18n.editBeetle}}</button>
      <button class="danger-btn" bindtap="deleteBeetle" style="min-height:70rpx; font-size:26rpx; line-height: 70rpx;">{{i18n.deleteBeetle}}</button>
      <button class="ghost-btn" bindtap="loadAll" style="min-height:70rpx; font-size:26rpx; line-height: 70rpx;">{{i18n.refresh}}</button>
    </view>
  </view>

  <!-- 甲虫编辑表单 -->
  <view wx:if="{{beetle && isEditingBeetle}}" class="card form-card">
    <view class="title" style="font-size:32rpx; font-weight:700; margin-bottom:16rpx;">{{i18n.editBeetleProfile}}</view>
    <input class="input" placeholder="{{i18n.namePlaceholder}}" value="{{editBeetleForm.name}}" data-key="name" bindinput="onEditBeetleInput" />
    <input class="input" placeholder="{{i18n.speciesPlaceholder}}" value="{{editBeetleForm.species}}" data-key="species" bindinput="onEditBeetleInput" />
    <picker mode="date" value="{{editBeetleForm.hatchDate}}" bindchange="onEditBeetleDateChange">
      <view class="picker {{editBeetleForm.hatchDate ? '' : 'picker-placeholder'}}">🗓️ {{editBeetleForm.hatchDate || i18n.hatchPurchaseDate}}</view>
    </picker>
    <textarea class="textarea" placeholder="{{i18n.notesPlaceholder}}" value="{{editBeetleForm.notes}}" data-key="notes" bindinput="onEditBeetleInput" />
    <view class="button-row">
      <button class="primary-btn" bindtap="saveBeetle">{{i18n.saveChanges}}</button>
      <button class="ghost-btn" bindtap="cancelEditBeetle">{{i18n.cancel}}</button>
    </view>
  </view>

  <!-- 成长曲线图表 -->
  <view wx:if="{{records.length >= 2}}" class="section-title">{{i18n.growthChart}}</view>
  <growth-chart wx:if="{{records.length >= 2}}" records="{{records}}" i18n="{{i18n}}" />

  <!-- 新增/编辑成长记录表单 -->
  <view class="section-title">{{editingRecordId ? i18n.editGrowthRecord : i18n.addGrowthRecord}}</view>
  <view class="card form-card">
    <picker mode="date" value="{{form.recordDate}}" bindchange="onRecordDateChange">
      <view class="picker {{form.recordDate ? '' : 'picker-placeholder'}}">📅 {{form.recordDate || i18n.recordDate}}</view>
    </picker>
    <picker range="{{stageLabels}}" value="{{stageIndex}}" bindchange="onStageChange">
      <view class="picker">🦋 {{stageLabels[stageIndex] || i18n.stage}}</view>
    </picker>
    <input class="input" type="digit" placeholder="{{i18n.weightPlaceholder}}" value="{{form.weight}}" data-key="weight" bindinput="onInput" />
    <input class="input" type="digit" placeholder="{{i18n.lengthPlaceholder}}" value="{{form.length}}" data-key="length" bindinput="onInput" />
    <input class="input" type="digit" placeholder="{{i18n.temperaturePlaceholder}}" value="{{form.temperature}}" data-key="temperature" bindinput="onInput" />
    <input class="input" type="digit" placeholder="{{i18n.humidityPlaceholder}}" value="{{form.humidity}}" data-key="humidity" bindinput="onInput" />
    <textarea class="textarea" placeholder="{{i18n.recordNotesPlaceholder}}" value="{{form.notes}}" data-key="notes" bindinput="onInput" />

    <view class="section-title" style="margin-top:0;">{{i18n.photos}}</view>
    <view class="img-grid">
      <view class="img-wrap" wx:for="{{selectedImages}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill"></image>
        <view class="img-remove" data-index="{{index}}" bindtap="removeImage">✕</view>
      </view>
      <view class="img-wrap" bindtap="chooseImages" wx:if="{{selectedImages.length < 9}}">
        <view class="img-add">
          <text class="img-add-icon">+</text>
          <text class="img-add-label">{{i18n.cameraAlbum}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{editingRecordId}}" class="button-row" style="margin-top: 16px;">
      <button class="primary-btn" bindtap="createRecord">{{i18n.saveChanges}}</button>
      <button class="ghost-btn" bindtap="cancelEditRecord">{{i18n.cancel}}</button>
    </view>
    <button wx:else class="primary-btn" bindtap="createRecord" style="margin-top: 16px;">{{i18n.saveRecord}}</button>
  </view>

  <!-- 历史记录列表 -->
  <view class="section-title">{{i18n.history}}</view>

  <view wx:if="{{records.length === 0}}" class="card">
    <view class="empty-records">
      <view class="empty-icon">📋</view>
      <view class="empty-text">{{i18n.emptyGrowthRecords}}</view>
    </view>
  </view>

  <view wx:for="{{records}}" wx:key="id" class="card record-card">
    <view class="record-head">
      <view class="record-date">{{item.recordDate || i18n.dateNotProvided}}</view>
      <view class="stage {{item.stageClass || ''}}">{{item.stageLabel || i18n.stageNotProvided}}</view>
    </view>

    <view class="metric-grid">
      <view class="metric-item">
        <view class="metric-label">{{i18n.weight}}</view>
        <view class="metric-value">{{item.weight || '-'}}<text class="metric-unit"> g</text></view>
      </view>
      <view class="metric-item">
        <view class="metric-label">{{i18n.length}}</view>
        <view class="metric-value">{{item.length || '-'}}<text class="metric-unit"> mm</text></view>
      </view>
      <view class="metric-item">
        <view class="metric-label">{{i18n.temperature}}</view>
        <view class="metric-value">{{item.temperature || '-'}}<text class="metric-unit"> ℃</text></view>
      </view>
      <view class="metric-item">
        <view class="metric-label">{{i18n.humidity}}</view>
        <view class="metric-value">{{item.humidity || '-'}}<text class="metric-unit"> %</text></view>
      </view>
    </view>

    <view wx:if="{{item.notes}}" class="notes">{{item.notes}}</view>

    <view wx:if="{{item.imageUrlsArray && item.imageUrlsArray.length > 0}}" class="img-grid">
      <view class="img-wrap" wx:for="{{item.imageUrlsArray}}" wx:key="*this" wx:for-item="url">
        <image src="{{url}}" mode="aspectFill" data-urls="{{item.imageUrlsArray}}" data-current="{{url}}" bindtap="previewImage"></image>
      </view>
    </view>

    <view class="record-actions" style="gap:16rpx;">
      <button class="small-btn" style="background:rgba(93,189,138,0.2); color:#5dbd8a; border:1rpx solid rgba(93,189,138,0.3);" data-record-id="{{item.id}}" bindtap="editRecord">{{i18n.edit}}</button>
      <button class="small-btn small-danger-btn" data-record-id="{{item.id}}" bindtap="deleteRecord">{{i18n.delete}}</button>
    </view>
  </view>
</view>
