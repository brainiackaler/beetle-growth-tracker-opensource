/* ========================================
   首页样式
   ======================================== */

/* --- Hero 区域 --- */
.language-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 12rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 22rpx;
}

.language-label {
  white-space: nowrap;
}

.language-picker {
  max-width: 360rpx;
  padding: 10rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.88);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero {
  padding: 36rpx 0 20rpx;
  position: relative;
  z-index: 1;
}

.hero-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #ffffff 0%, #8fd4a8 50%, #5dbd8a 100%);
  -webkit-background-clip: text;
  color: transparent;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.hero-divider {
  margin-top: 28rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(93, 189, 138, 0.3), transparent);
}

.auth-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.auth-tab {
  flex: 1;
  margin: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
}

.auth-tab.active {
  border-color: rgba(93, 189, 138, 0.5);
  background: rgba(93, 189, 138, 0.14);
  color: #b8f2cf;
}

.account-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8rpx;
}

.logout-btn {
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  line-height: 58rpx;
}

/* --- 甲虫卡片 --- */
.beetle-card {
  transition: all 0.2s ease;
}

.beetle-card:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.985);
}

.beetle-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.beetle-name {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
}

.beetle-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.25);
  transition: transform 0.2s ease;
}

.beetle-card:active .beetle-arrow {
  transform: translateX(6rpx);
  color: rgba(93, 189, 138, 0.6);
}

.beetle-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.meta-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.meta-icon {
  font-size: 20rpx;
}

/* --- 新增表单卡片 --- */
.form-card {
  border: 1rpx dashed rgba(93, 189, 138, 0.3);
  background: rgba(93, 189, 138, 0.04);
}
