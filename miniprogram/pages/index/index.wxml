<view class="page">
  <view class="language-row">
    <text class="language-label">🌐 {{i18n.interfaceLanguage}}</text>
    <picker
      range="{{languageOptions}}"
      range-key="label"
      value="{{languageIndex}}"
      bindchange="onLanguageChange"
    >
      <view class="language-picker">{{languageOptions[languageIndex].label}}⌄</view>
    </picker>
  </view>

  <!-- Hero 区域 -->
  <view class="hero">
    <view class="hero-icon">🪲</view>
    <view class="hero-title">{{i18n.appTitle}}</view>
    <view class="hero-subtitle">{{statusText}}</view>
    <view class="hero-divider"></view>
  </view>

  <view wx:if="{{!authenticated}}">
    <view class="section-title">{{i18n.account}}</view>
    <view class="card form-card">
      <view class="auth-tabs">
        <button class="auth-tab {{authMode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="setAuthMode">{{i18n.login}}</button>
        <button class="auth-tab {{authMode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="setAuthMode">{{i18n.register}}</button>
      </view>
      <input class="input" placeholder="{{i18n.username}}" value="{{authForm.username}}" data-key="username" bindinput="onAuthInput" />
      <input class="input" password placeholder="{{i18n.password}}" value="{{authForm.password}}" data-key="password" bindinput="onAuthInput" />
      <button class="primary-btn" bindtap="submitAuth">{{authMode === 'login' ? i18n.login : i18n.register}}</button>
    </view>
  </view>

  <block wx:else>
  <view class="account-row">
    <button class="logout-btn" bindtap="logout">{{i18n.logout}}</button>
  </view>

  <!-- 新增甲虫表单 -->
  <view class="section-title">{{i18n.addBeetle}}</view>
  <view class="card form-card">
    <input class="input" placeholder="{{i18n.namePlaceholder}}" value="{{form.name}}" data-key="name" bindinput="onInput" />
    <input class="input" placeholder="{{i18n.speciesPlaceholder}}" value="{{form.species}}" data-key="species" bindinput="onInput" />
    <picker mode="date" value="{{form.hatchDate}}" bindchange="onDateChange">
      <view class="picker {{form.hatchDate ? '' : 'picker-placeholder'}}">{{form.hatchDate || '🗓️ ' + i18n.hatchPurchaseDate}}</view>
    </picker>
    <textarea class="textarea" placeholder="{{i18n.notesPlaceholder}}" value="{{form.notes}}" data-key="notes" bindinput="onInput" />
    <button class="primary-btn" bindtap="createBeetle">{{i18n.saveBeetle}}</button>
  </view>

  <!-- 甲虫列表 -->
  <view class="section-title">{{i18n.myBeetles}}</view>

  <view wx:if="{{beetles.length === 0}}" class="card">
    <view class="empty-state">
      <view class="empty-icon">🌿</view>
      <view class="empty-text">{{i18n.emptyBeetles}}</view>
    </view>
  </view>

  <view wx:for="{{beetles}}" wx:key="id" class="card beetle-card" data-id="{{item.id}}" bindtap="goDetail">
    <view class="beetle-header">
      <view class="beetle-name">{{item.name || i18n.unnamedBeetle}}</view>
      <view class="beetle-arrow">›</view>
    </view>
    <view class="beetle-meta">
      <view wx:if="{{item.species}}" class="meta-tag">
        <text class="meta-icon">🪲</text>
        <text>{{item.species}}</text>
      </view>
      <view wx:if="{{item.hatchDate}}" class="meta-tag">
        <text class="meta-icon">📅</text>
        <text>{{item.hatchDate}}</text>
      </view>
    </view>
    <view wx:if="{{item.notes}}" class="notes">{{item.notes}}</view>
  </view>
  </block>
</view>
