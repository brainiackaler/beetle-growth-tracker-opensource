<view class="chart-wrap">
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'weight' ? 'active' : ''}}" data-tab="weight" bindtap="switchTab">{{i18n.weight}}</view>
    <view class="tab-item {{activeTab === 'length' ? 'active' : ''}}" data-tab="length" bindtap="switchTab">{{i18n.length}}</view>
    <view class="tab-item {{activeTab === 'temperature' ? 'active' : ''}}" data-tab="temperature" bindtap="switchTab">{{i18n.temperature}}</view>
    <view class="tab-item {{activeTab === 'humidity' ? 'active' : ''}}" data-tab="humidity" bindtap="switchTab">{{i18n.humidity}}</view>
  </view>
  <view class="canvas-container">
    <canvas type="2d" id="growthCanvas" class="chart-canvas"></canvas>
    <view wx:if="{{noData}}" class="chart-empty">
      <text>{{i18n.noMetricData}}</text>
    </view>
  </view>
</view>
